{
  "name": "roadsignmath.xyz",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import tsx src/dev.ts",
    "format": "prettier --write --no-error-on-unmatched-pattern \"{src,tools,test}/**/*.{ts,tsx}\" \"*.{ts,json}\" \"contracts/*.json\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"{src,tools,test}/**/*.{ts,tsx}\" \"*.{ts,json}\" \"contracts/*.json\"",
    "lint": "oxlint src tools test --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "contract": "node --import tsx tools/export-api-contract.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1150.0",
    "@aws-sdk/lib-dynamodb": "3.1150.0",
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
