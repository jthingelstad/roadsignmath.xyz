{
  "name": "roadsignmath.xyz",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import tsx src/dev.ts",
    "format": "prettier --write --no-error-on-unmatched-pattern \"{src,tools,test}/**/*.{ts,tsx}\" \"*.{ts,json}\" \"contracts/*.json\" \"seed/*.json\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"{src,tools,test}/**/*.{ts,tsx}\" \"*.{ts,json}\" \"contracts/*.json\" \"seed/*.json\"",
    "lint": "oxlint src tools test --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "contract": "node --import tsx tools/export-api-contract.ts",
    "us-map": "node --import tsx tools/us-map.ts && prettier --write src/web/us-map.ts",
    "app-assets": "node --import tsx tools/app-assets.ts",
    "build:server": "node --import tsx tools/build-server.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "seed": "node --import tsx tools/seed-microblog.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@aws-sdk/client-cloudfront": "3.1150.0",
    "@aws-sdk/client-dynamodb": "3.1150.0",
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/client-secrets-manager": "3.1150.0",
    "@aws-sdk/client-sesv2": "3.1150.0",
    "@aws-sdk/lib-dynamodb": "3.1150.0",
    "@hono/node-server": "2.1.4",
    "d3-geo": "3.1.1",
    "hono": "4.13.13",
    "mathjax-full": "3.2.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1150.0",
    "@aws-sdk/client-lambda-web": "3.1150.0",
    "@aws-sdk/client-sts": "3.1150.0",
    "@types/d3-geo": "3.1.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@types/yazl": "3.3.1",
    "esbuild": "0.28.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "qrcode": "1.5.4",
    "topojson-client": "3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "us-atlas": "3.0.1",
    "yazl": "3.3.1"
  }
}
